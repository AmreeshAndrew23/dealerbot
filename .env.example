# ---- Database (local PostgreSQL 17) ----
# Create the database once:  psql -U postgres -c "CREATE DATABASE fmcg_assistant"
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/fmcg_assistant

# ---- HTTP ----
PORT=3100
LOG_LEVEL=info

# ---- WhatsApp Cloud API (Meta developer console) ----
# App settings > Basic > App secret. Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Any random string you choose. Paste the same value into the Meta webhook "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
# WhatsApp > API Setup > access token (temporary 24h token for testing, or a System User token).
# Channel accounts reference it as  env:WHATSAPP_ACCESS_TOKEN  (never stored in the database).
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0

# ---- Media ----
MEDIA_STORAGE_DIR=./storage
MEDIA_MAX_BYTES=16777216
MEDIA_RETENTION_DAYS=90

# ---- OpenAI ----
# API key from platform.openai.com > API keys. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- WhatsApp TEST bridge (pnpm wa:test) - TESTING ONLY, until the Meta Cloud API number is live ----
# Uses the unofficial WhatsApp Web library Baileys: link a spare SIM / test number, never the
# business's main number (WhatsApp may ban numbers that run unofficial clients).
# Who it answers is set on the dashboard Retailers page (not in this file).

# ---- Customer app (apps/shop, pnpm dev:shop) ----
# The address retailers open on their phone. Staff share it together with the access code.
RETAILER_APP_URL=http://localhost:5181
